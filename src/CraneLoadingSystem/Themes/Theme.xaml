<!--
  CraneLoadingSystem  Modern Theme v1.0
  设计令牌（Design Tokens）+ 统一样式
  参考：Fluent UI / Tailwind 配色体系 / Material Design 3 规范
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         1. Design Tokens：调色板（Tailwind 语义色）
         ============================================================ -->
    <!-- 中性色（灰阶） -->
    <Color x:Key="Gray-50">  #F9FAFB</Color>
    <Color x:Key="Gray-100"> #F3F4F6</Color>
    <Color x:Key="Gray-200"> #E5E7EB</Color>
    <Color x:Key="Gray-300"> #D1D5DB</Color>
    <Color x:Key="Gray-400"> #9CA3AF</Color>
    <Color x:Key="Gray-500"> #6B7280</Color>
    <Color x:Key="Gray-600"> #4B5563</Color>
    <Color x:Key="Gray-700"> #374151</Color>
    <Color x:Key="Gray-800"> #1F2937</Color>
    <Color x:Key="Gray-900"> #111827</Color>

    <!-- 品牌色（主色 Indigo-600 体系） -->
    <Color x:Key="Primary-50">  #EEF2FF</Color>
    <Color x:Key="Primary-100"> #E0E7FF</Color>
    <Color x:Key="Primary-500"> #6366F1</Color>
    <Color x:Key="Primary-600"> #4F46E5</Color>
    <Color x:Key="Primary-700"> #4338CA</Color>

    <!-- 强调色（天青，用于辅助操作/链接） -->
    <Color x:Key="Accent-400">#38BDF8</Color>
    <Color x:Key="Accent-500">#0EA5E9</Color>
    <Color x:Key="Accent-600">#0284C7</Color>

    <!-- 语义色（状态） -->
    <Color x:Key="Success-50">  #ECFDF5</Color>
    <Color x:Key="Success-400"> #34D399</Color>
    <Color x:Key="Success-500"> #10B981</Color>
    <Color x:Key="Success-600"> #059669</Color>
    <Color x:Key="Warning-50">  #FFFBEB</Color>
    <Color x:Key="Warning-400"> #FBBF24</Color>
    <Color x:Key="Warning-500"> #F59E0B</Color>
    <Color x:Key="Danger-50">   #FEF2F2</Color>
    <Color x:Key="Danger-400">  #F87171</Color>
    <Color x:Key="Danger-500">  #EF4444</Color>
    <Color x:Key="Danger-600">  #DC2626</Color>
    <Color x:Key="Danger-700">  #B91C1C</Color>
    <Color x:Key="Info-50">     #EFF6FF</Color>
    <Color x:Key="Info-400">    #60A5FA</Color>
    <Color x:Key="Info-500">    #3B82F6</Color>
    <Color x:Key="Info-600">    #2563EB</Color>

    <!-- ============================================================
         2. 画刷 / 常用令牌
         ============================================================ -->
    <!-- 背景 -->
    <SolidColorBrush x:Key="AppBackground"       Color="{StaticResource Gray-100}"/>
    <SolidColorBrush x:Key="PanelBackground"     Color="{StaticResource Gray-50}"/>
    <SolidColorBrush x:Key="CardBackground"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TitleBarBackground"  Color="{StaticResource Gray-900}"/>
    <SolidColorBrush x:Key="ToolBarBackground"   Color="{StaticResource Gray-800}"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="{StaticResource Gray-700}"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderLight"    Color="{StaticResource Gray-200}"/>
    <SolidColorBrush x:Key="BorderDefault"  Color="{StaticResource Gray-300}"/>
    <SolidColorBrush x:Key="BorderStrong"   Color="{StaticResource Gray-400}"/>

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextPrimary"    Color="{StaticResource Gray-900}"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="{StaticResource Gray-600}"/>
    <SolidColorBrush x:Key="TextTertiary"   Color="{StaticResource Gray-400}"/>
    <SolidColorBrush x:Key="TextInverse"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextOnPrimary"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextOnDanger"   Color="#FFFFFFFF"/>

    <!-- 主色画刷 -->
    <SolidColorBrush x:Key="PrimaryBrush"      Color="{StaticResource Primary-600}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource Primary-500}"/>
    <SolidColorBrush x:Key="SuccessBrush"      Color="{StaticResource Success-500}"/>
    <SolidColorBrush x:Key="WarningBrush"      Color="{StaticResource Warning-500}"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource Danger-500}"/>
    <SolidColorBrush x:Key="DangerDarkBrush"   Color="{StaticResource Danger-700}"/>
    <SolidColorBrush x:Key="InfoBrush"         Color="{StaticResource Info-500}"/>

    <!-- 卡片阴影（用 DropShadowEffect 模拟） -->
    <DropShadowEffect x:Key="ShadowCardSm" Color="#FF000000" BlurRadius="4"  ShadowDepth="0" Opacity="0.06"/>
    <DropShadowEffect x:Key="ShadowCard"    Color="#FF000000" BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
    <DropShadowEffect x:Key="ShadowCardLg"  Color="#FF000000" BlurRadius="20" ShadowDepth="2" Opacity="0.10"/>
    <DropShadowEffect x:Key="ShadowEmphasis" Color="#FF000000" BlurRadius="14" ShadowDepth="2" Opacity="0.18"/>

    <!-- 渐变（用于标题栏/按钮悬停/状态徽章） -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Gray-900}" Offset="0"/>
        <GradientStop Color="{StaticResource Gray-800}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary-500}" Offset="0"/>
        <GradientStop Color="{StaticResource Primary-700}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Success-400}" Offset="0"/>
        <GradientStop Color="{StaticResource Success-600}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFEF4444" Offset="0"/>
        <GradientStop Color="#FFB91C1C" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================
         3. 全局字体
         ============================================================ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- ============================================================
         4. 现代化 Button（基于 ControlTemplate，圆角 + 悬停阴影 + 按下缩放）
         ============================================================ -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{StaticResource Gray-200}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="Shadow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：提亮 + 微阴影 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            <Setter TargetName="Shadow" Property="BlurRadius" Value="6"/>
                            <Setter TargetName="Shadow" Property="Opacity" Value="0.22"/>
                        </Trigger>
                        <!-- 按下：缩小 3% + 更深阴影 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Scale" Property="ScaleX" Value="0.97"/>
                            <Setter TargetName="Scale" Property="ScaleY" Value="0.97"/>
                            <Setter TargetName="Shadow" Property="BlurRadius" Value="2"/>
                            <Setter TargetName="Shadow" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <!-- 禁用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE5E7EB"/>
                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                            <Setter Property="Cursor" Value="No"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         5. 语义化按钮子样式（Primary / Success / Danger / Warning / Ghost）
         使用方式：
           <Button Style="{StaticResource ButtonPrimary}" Content="启动"/>
         ============================================================ -->
    <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimary}"/>
    </Style>
    <Style x:Key="ButtonSuccess" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnDanger}"/>
    </Style>
    <Style x:Key="ButtonDangerStrong" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerDarkBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="ButtonWarning" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        <Setter Property="Foreground" Value="#FF1F2937"/>
    </Style>
    <Style x:Key="ButtonInfo" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="ButtonGhost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
    </Style>

    <!-- ============================================================
         6. 现代化 TextBox（下划线 / 聚焦发光）
         ============================================================ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="FocusGlow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                        </Border.Effect>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="FocusGlow" Property="Color" Value="{StaticResource Primary-500}"/>
                            <Setter TargetName="FocusGlow" Property="BlurRadius" Value="8"/>
                            <Setter TargetName="FocusGlow" Property="Opacity" Value="0.35"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gray-50}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gray-100}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         7. ProgressBar（平滑 + 渐变色）
         ============================================================ -->
    <Style TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="Background" Value="{StaticResource Gray-200}"/>
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="Track"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            Padding="0" Height="{TemplateBinding MinHeight}">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="4" RadiusY="4"
                                               Rect="0,0,{TemplateBinding ActualWidth},{TemplateBinding ActualHeight}"/>
                        </Border.Clip>
                        <Grid>
                            <Border x:Name="PART_Indicator" CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         8. GroupBox（现代化 - 圆角 + 淡标题）
         ============================================================ -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Gray-50}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Padding" Value="10,8,10,8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 标题 -->
                        <Border Grid.Row="0" CornerRadius="0" Padding="2,0" Margin="8,-2,8,0"
                                HorizontalAlignment="Left" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=GroupBox}}">
                            <ContentPresenter ContentSource="Header"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource TextSecondary}"
                                              TextElement.FontSize="11"/>
                        </Border>
                        <!-- 内容区 -->
                        <Border Grid.Row="1" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" Margin="0,6,0,0">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         9. TabItem（胶囊风格 Tab）
         ============================================================ -->
    <Style TargetType="TabItem" x:Key="PillTabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" CornerRadius="999" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}">
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gray-100}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
        10. DataGrid（现代化 - 斑马纹 + 选中高亮）
         ============================================================ -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Gray-100}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#FFFAFBFC"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Gray-50}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gray-100}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="2,0,2,0" CornerRadius="4" Margin="4,1">
                        <DataGridCellsPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Info-50}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Primary-50}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary-100}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
        11. Separator（细线）
         ============================================================ -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderLight}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
        12. ListBox（现代化选中）
         ============================================================ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Gray-50}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ============================================================
        13. 工具类样式：卡片容器（Card）、状态徽章、字段标签/数值
         ============================================================ -->
    <!-- 通用 Card：白底 + 圆角 + 细边框 + 柔和阴影 -->
    <Style x:Key="CardContainer" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource ShadowCard}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- 小卡片（内嵌容器/指标框） -->
    <Style x:Key="MiniCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Gray-50}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gray-100}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- 字段 Label / Value -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="FieldValueBig" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
    </Style>

    <!-- 胶囊标签（Pill badge） -->
    <Style x:Key="PillBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 鹤位状态徽章（8 种语义色 + Pill） -->
    <SolidColorBrush x:Key="StatusIdleBrush"       Color="{StaticResource Gray-500}"/>
    <SolidColorBrush x:Key="StatusReadyBrush"      Color="{StaticResource Accent-500}"/>
    <SolidColorBrush x:Key="StatusLoadingBrush"    Color="{StaticResource Success-500}"/>
    <SolidColorBrush x:Key="StatusPausedBrush"     Color="{StaticResource Warning-500}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush"  Color="{StaticResource Info-500}"/>
    <SolidColorBrush x:Key="StatusFaultBrush"      Color="{StaticResource Danger-500}"/>
    <SolidColorBrush x:Key="StatusOfflineBrush"    Color="{StaticResource Gray-700}"/>
    <SolidColorBrush x:Key="StatusEmergencyBrush"  Color="{StaticResource Danger-700}"/>
</ResourceDictionary>
