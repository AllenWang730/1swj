<Window x:Class="CraneLoadingSystem.Views.DispatchOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CraneLoadingSystem.Views"
        mc:Ignorable="d"
        Title="下发单据到鹤位" Height="480" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="#FFF5F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <local:RecommendedFlagConverter x:Key="RecommendedFlagConv"/>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF555555"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 单据信息 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" BorderBrush="#FFE5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📋 单据信息" FontWeight="Bold" FontSize="14" Foreground="#FF2C3E50" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Label}" Text="单据编号"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding SelectedOrder.OrderNo, FallbackValue=''}"/>
                        <TextBlock Style="{StaticResource Label}" Text="客户"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding SelectedOrder.CustomerName, FallbackValue=''}"/>
                        <TextBlock Style="{StaticResource Label}" Text="司机/电话"/>
                        <TextBox Style="{StaticResource FieldBox}">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}{0}  {1}">
                                    <Binding Path="SelectedOrder.DriverName"/>
                                    <Binding Path="SelectedOrder.DriverPhone"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Label}" Text="车牌号码"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding SelectedOrder.VehicleNo, FallbackValue=''}"/>
                        <TextBlock Style="{StaticResource Label}" Text="产品"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding SelectedOrder.ProductName, FallbackValue=''}"/>
                        <TextBlock Style="{StaticResource Label}" Text="计划装载量 (kg)"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding SelectedOrder.PlannedWeight, StringFormat='{}{0:F2} kg'}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 鹤位选择 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                BorderBrush="#FFE5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="🏭 选择鹤位" FontWeight="Bold" FontSize="14" Foreground="#FF2C3E50" VerticalAlignment="Center"/>
                    <Button Content="🔄 刷新可用鹤位" Margin="8,0,0,0" Padding="8,4" FontSize="11"
                            Background="#FF3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Command="{Binding RefreshAvailableCommand}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding AvailableCranes}" SelectedItem="{Binding SelectedCrane}"
                         Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="8"
                                                BorderBrush="Transparent" BorderThickness="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 状态指示圆 -->
                                                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="#6C757D"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="Bold" FontSize="13"
                                                               Text="{Binding Name}"/>
                                                    <TextBlock FontSize="11" Foreground="#FF777777">
                                                        <Run Text="产品: "/>
                                                        <Run Text="{Binding Config.ProductName}"/>
                                                        <Run Text=" · 状态: "/>
                                                        <Run Text="{Binding Status}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="#FFE8F4FE" CornerRadius="4" Padding="8,3"
                                                        VerticalAlignment="Center" Visibility="{Binding Id, Converter={StaticResource RecommendedFlagConv}}">
                                                    <TextBlock Foreground="#FF1976D2" FontSize="10" FontWeight="Bold" Text="✓ 推荐"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFEFF6FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFDBEAFE"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3B82F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="0"/> <!-- 占位，使用ItemContainerStyle中的Template -->
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 底部操作栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="100" Height="36" Margin="4,0"
                    Click="CancelButton_Click" Background="#FFE5E7EB" BorderThickness="0" Cursor="Hand"/>
            <Button Content="✓ 确认下发" Width="120" Height="36" Margin="4,0" Background="#FF28A745" Foreground="White"
                    BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                    Click="ConfirmButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
