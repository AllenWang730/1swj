<UserControl x:Class="CraneLoadingSystem.Views.CranePositionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CraneLoadingSystem.Views"
             xmlns:models="clr-namespace:CraneLoadingSystem.Models"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="480"
             x:Name="CraneCardRoot">
    <UserControl.Resources>
        <!-- Converter声明 -->
        <local:SecondsToMinutesConverter x:Key="SecToMinConv"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisConv"/>

        <!-- 状态颜色资源字典 -->
        <Style x:Key="StatusBadgeIdle" TargetType="Border">
            <Setter Property="Background" Value="#FF6C757D"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="StatusBadgeReady" TargetType="Border">
            <Setter Property="Background" Value="#FF17A2B8"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="StatusBadgeLoading" TargetType="Border">
            <Setter Property="Background" Value="#FF28A745"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="StatusBadgePaused" TargetType="Border">
            <Setter Property="Background" Value="#FFFFC107"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="StatusBadgeCompleted" TargetType="Border">
            <Setter Property="Background" Value="#FF007BFF"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="StatusBadgeFault" TargetType="Border">
            <Setter Property="Background" Value="#FFDC3545"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="StatusBadgeOffline" TargetType="Border">
            <Setter Property="Background" Value="#FF343A40"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="StatusBadgeEmergency" TargetType="Border">
            <Setter Property="Background" Value="#FF8B0000"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- 数据显示模板 -->
        <Style TargetType="TextBlock" x:Key="DataLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FF888888"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="DataValue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF222222"/>
        </Style>
        <Style TargetType="Button" x:Key="ControlBtnBase">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="8" BorderBrush="#FFE0E0E0" BorderThickness="1"
            Padding="12" Margin="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 头部：鹤位名称 + 状态 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name, FallbackValue=1#鹤位}"
                               FontSize="20" FontWeight="Bold" Foreground="#FF2C3E50" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Config.ProductName, FallbackValue=汽油}"
                               FontSize="12" Foreground="#FF7F8C8D" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 状态Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- PLC连接状态指示灯 -->
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                        <Setter Property="Fill" Value="#28A745"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <Border Padding="10,4" x:Name="StatusBorder">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF6C757D"/>
                                <Setter Property="CornerRadius" Value="10"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                                        <Setter Property="Background" Value="#FF17A2B8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Loading">
                                        <Setter Property="Background" Value="#FF28A745"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                        <Setter Property="Background" Value="#FFFFC107"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="Background" Value="#FF007BFF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Fault">
                                        <Setter Property="Background" Value="#FFDC3545"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                        <Setter Property="Background" Value="#FF343A40"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="EmergencyStop">
                                        <Setter Property="Background" Value="#FF8B0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="StatusText" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 分隔线 -->
            <Grid Grid.Row="1">
                <Rectangle Height="1" Fill="#FFEEEEEE" Margin="0,4"/>
            </Grid>

            <!-- 单据信息行 -->
            <Grid Grid.Row="2" Margin="0,6,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource DataLabel}" Text="单据编号"/>
                    <TextBlock Style="{StaticResource DataValue}"
                               Text="{Binding CurrentOrder.OrderNo, FallbackValue=--- 未分配 ---}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource DataLabel}" Text="车牌"/>
                    <TextBlock Style="{StaticResource DataValue}"
                               Text="{Binding CurrentOrder.VehicleNo, FallbackValue=---}"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- 客户+产品行 -->
            <Grid Grid.Row="3" Margin="0,2,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource DataLabel}" Text="客户"/>
                    <TextBlock Style="{StaticResource DataValue}"
                               Text="{Binding CurrentOrder.CustomerName, FallbackValue=---}"
                               TextTrimming="CharacterEllipsis" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource DataLabel}" Text="产品"/>
                    <TextBlock Style="{StaticResource DataValue}"
                               Text="{Binding CurrentOrder.ProductName, FallbackValue=---}"
                               HorizontalAlignment="Right" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- 进度条 + 装载量 -->
            <Grid Grid.Row="4" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DataLabel}" Text="装料进度"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource DataValue}"
                                   Text="{Binding RealtimeData.Progress, StringFormat='{}{0:F1}%', FallbackValue=0%}"
                                   HorizontalAlignment="Right" FontSize="13"/>
                    </Grid>
                    <ProgressBar x:Name="LoadingProgressBar"
                                 Value="{Binding RealtimeData.Progress}" Minimum="0" Maximum="100"
                                 Height="16" Margin="0,4,0,0"
                                 Background="#FFEEEEEE" Foreground="#FF28A745">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="#FF28A745"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                        <Setter Property="Foreground" Value="#FFFFC107"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="EmergencyStop">
                                        <Setter Property="Foreground" Value="#FFDC3545"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Fault">
                                        <Setter Property="Foreground" Value="#FFDC3545"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="Foreground" Value="#FF007BFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource DataLabel}" Text="已装 / 计划 (kg)" HorizontalAlignment="Right"/>
                    <TextBlock HorizontalAlignment="Right">
                        <Run Style="{StaticResource DataValue}"
                             Text="{Binding RealtimeData.LoadedWeight, StringFormat='{}{0:F1}', FallbackValue=0}"/>
                        <Run Text=" / " Foreground="#FFBBBBBB"/>
                        <Run Style="{StaticResource DataValue}"
                             Text="{Binding CurrentOrder.PlannedWeight, StringFormat='{}{0:F0}', FallbackValue=0}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- 实时数据仪表 -->
            <Grid Grid.Row="5" Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 瞬时流量 -->
                <Border Grid.Column="0" Background="#FFF8F9FA" CornerRadius="6" Margin="0,0,4,0" Padding="6,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DataLabel}" Text="瞬时流量"/>
                        <TextBlock Style="{StaticResource DataValue}" FontSize="15"
                                   Text="{Binding RealtimeData.InstantFlow, StringFormat='{}{0:F1} L/min', FallbackValue='0.0 L/min'}"/>
                    </StackPanel>
                </Border>

                <!-- 入口压力 -->
                <Border Grid.Column="1" Background="#FFF8F9FA" CornerRadius="6" Margin="2,0,2,0" Padding="6,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DataLabel}" Text="入口压力"/>
                        <TextBlock Style="{StaticResource DataValue}" FontSize="15"
                                   Text="{Binding RealtimeData.InletPressure, StringFormat='{}{0:F2} MPa', FallbackValue='0.00 MPa'}"/>
                    </StackPanel>
                </Border>

                <!-- 温度 -->
                <Border Grid.Column="2" Background="#FFF8F9FA" CornerRadius="6" Margin="2,0,2,0" Padding="6,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DataLabel}" Text="温度"/>
                        <TextBlock Style="{StaticResource DataValue}" FontSize="15"
                                   Text="{Binding RealtimeData.Temperature, StringFormat='{}{0:F1} ℃', FallbackValue='0.0 ℃'}"/>
                    </StackPanel>
                </Border>

                <!-- 时间 -->
                <Border Grid.Column="3" Background="#FFF8F9FA" CornerRadius="6" Margin="4,0,0,0" Padding="6,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DataLabel}" Text="已用 / 剩余 (分)"/>
                        <TextBlock Style="{StaticResource DataValue}" FontSize="15">
                            <Run Text="{Binding RealtimeData.ElapsedSeconds, Converter={StaticResource SecToMinConv}, FallbackValue='0'}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding RealtimeData.EstimatedRemainingSeconds, Converter={StaticResource SecToMinConv}, FallbackValue='0'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 安全联锁8项矩阵 -->
            <GroupBox Grid.Row="6" Header="安全联锁" FontSize="11" Padding="6,4" BorderBrush="#FFDDDDDD" Margin="0,4,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl ItemsSource="{Binding SafetyInterlocks}" AlternationCount="8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Margin="0,2" ToolTip="{Binding Name}">
                                    <Ellipse Width="18" Height="18" HorizontalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FF28A745"/>
                                                <Setter Property="Stroke" Value="#FF1E7E34"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StartupSatisfied}" Value="False">
                                                        <Setter Property="Fill" Value="#FFDC3545"/>
                                                        <Setter Property="Stroke" Value="#FF8B0000"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAlarming}" Value="True">
                                                        <Setter Property="Fill" Value="#FFDC3545"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center"
                                               Margin="0,1,0,0" Foreground="#FF555555"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </GroupBox>

            <!-- 缺失提示文本 -->
            <TextBlock Grid.Row="7" FontSize="10" Foreground="#FFDC3545" Margin="0,0,0,4"
                       Text="{Binding MissingInterlockNames, FallbackValue=''}"
                       Visibility="{Binding AllInterlocksSatisfied, Converter={StaticResource BoolToVisConv}, ConverterParameter=Invert, FallbackValue=Collapsed}"/>

            <!-- 控制按钮 -->
            <GroupBox Grid.Row="8" Header="控制操作" FontSize="11" Padding="6,4" BorderBrush="#FFDDDDDD">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 启动 -->
                    <Button Grid.Column="0" Content="▶ 启动"
                            Background="#FF28A745" Foreground="White" BorderThickness="0"
                            Command="{Binding StartCommand, ElementName=CraneCardRoot}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBtnBase}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Idle">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 暂停/恢复 -->
                    <Button Grid.Column="1" Content="⏸ 暂停" Foreground="White" BorderThickness="0"
                            Background="#FF6C757D"
                            Command="{Binding PauseCommand, ElementName=CraneCardRoot}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBtnBase}">
                                <Setter Property="Background" Value="#FF6C757D"/>
                                <Setter Property="Content" Value="⏸ 暂停"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Loading">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Setter Property="Background" Value="#FF6C757D"/>
                                        <Setter Property="Content" Value="⏸ 暂停"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Setter Property="Background" Value="#FF17A2B8"/>
                                        <Setter Property="Content" Value="▶ 恢复"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 停止 -->
                    <Button Grid.Column="2" Content="⏹ 停止"
                            Background="#FFDC3545" Foreground="White" BorderThickness="0"
                            Command="{Binding StopCommand, ElementName=CraneCardRoot}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBtnBase}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Loading">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Ready">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 复位 -->
                    <Button Grid.Column="3" Content="↻ 复位"
                            Background="#FF17A2B8" Foreground="White" BorderThickness="0"
                            Command="{Binding ResetCommand, ElementName=CraneCardRoot}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBtnBase}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Fault">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 紧急停止 -->
                    <Button Grid.Column="4" Style="{StaticResource ControlBtnBase}" Content="⚠ 急停"
                            Background="#FF8B0000" Foreground="White" BorderThickness="0" FontWeight="Bold"
                            Command="{Binding EmergencyStopCommand, ElementName=CraneCardRoot}">
                        <Button.ToolTip>紧急停止（立即切断所有阀门、停泵）</Button.ToolTip>
                    </Button>
                </Grid>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>
