<Window x:Class="CraneLoadingSystem.Views.ManualOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手工创建单据" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F7FA"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="客户名称" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="CustomerName" Height="32" Padding="6" BorderBrush="#CCC" Margin="0,0,0,14"/>

                <TextBlock Text="车牌号码" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="VehicleNo" Height="32" Padding="6" BorderBrush="#CCC" Margin="0,0,0,14"/>

                <TextBlock Text="产品编码" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="ProductCode" Height="32" Padding="6" BorderBrush="#CCC" Margin="0,0,0,14" Text="P001"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="产品名称" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="ProductName" Height="32" Padding="6" BorderBrush="#CCC" Margin="0,0,0,14" Text="92#车用汽油"/>

                <TextBlock Text="计划装载量 (kg)" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="PlannedWeight" Height="32" Padding="6" BorderBrush="#CCC" Margin="0,0,0,14" Text="20000"/>

                <TextBlock Text="允许误差 (kg)" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="Tolerance" Height="32" Padding="6" BorderBrush="#CCC" Margin="0,0,0,14" Text="50"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="36" Click="Cancel_Click" Background="#E5E7EB" BorderThickness="0" Margin="4,0"/>
            <Button Content="创建" Width="90" Height="36" Click="Confirm_Click" Background="#28A745" Foreground="White"
                    BorderThickness="0" FontWeight="Bold" IsDefault="True" Margin="4,0"/>
        </StackPanel>
    </Grid>
</Window>
