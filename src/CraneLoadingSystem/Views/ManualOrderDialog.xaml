<Window x:Class="CraneLoadingSystem.Views.ManualOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手工创建单据" Height="480" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource GlobalFontFamily}" FontSize="{StaticResource GlobalFontSize}"
        SnapsToDevicePixels="True">

    <Border Style="{StaticResource CardContainer}" Margin="20" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="4" Height="22" CornerRadius="2" Background="{StaticResource SuccessGradient}" VerticalAlignment="Center"/>
                <TextBlock Text="📦 手工创建装料单据" FontWeight="Bold" FontSize="16"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 表单区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左列 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="客户名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CustomerName" />
                    <TextBlock Text="车牌号码" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <TextBox x:Name="VehicleNo" />
                    <TextBlock Text="产品编码" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <TextBox x:Name="ProductCode" Text="P001"/>
                </StackPanel>

                <!-- 右列 -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="产品名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ProductName" Text="92#车用汽油"/>
                    <TextBlock Text="计划装载量 (kg)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <TextBox x:Name="PlannedWeight" Text="20000"/>
                    <TextBlock Text="允许误差 (kg)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <TextBox x:Name="Tolerance" Text="50"/>
                </StackPanel>
            </Grid>

            <!-- 底部操作 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource ButtonGhost}" Width="100" Height="36"
                        Click="Cancel_Click" Margin="4,0"/>
                <Button Content="创建" Style="{StaticResource ButtonSuccess}" Width="100" Height="36"
                        FontWeight="Bold" Click="Confirm_Click" IsDefault="True" Margin="8,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
