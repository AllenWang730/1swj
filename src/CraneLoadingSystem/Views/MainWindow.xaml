<Window x:Class="CraneLoadingSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CraneLoadingSystem.Views"
        xmlns:models="clr-namespace:CraneLoadingSystem.Models"
        Title="{Binding AppTitle}" Height="900" Width="1500" MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource GlobalFontFamily}" FontSize="{StaticResource GlobalFontSize}"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing" Loaded="Window_Loaded">

    <DockPanel>
        <!-- ===================== 顶部标题栏（深色渐变 + 柔和阴影） ===================== -->
        <Border DockPanel.Dock="Top" Effect="{StaticResource ShadowCard}">
            <StackPanel TextElement.Foreground="White">
                <!-- 标题栏 -->
                <Grid Height="56" Margin="20,0,20,0" Background="{StaticResource HeaderGradient}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo 容器（圆角小方块 + 渐变） -->
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource PrimaryGradient}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="⛽" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding AppTitle}" VerticalAlignment="Center"/>
                            <TextBlock Text="Crane Loading Management System"
                                       Foreground="#9CA3AF" FontSize="10" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Width="1" Height="28" Background="#374151" Margin="20,12" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="运行时长" Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock x:Name="RunTimeText" Foreground="#60A5FA" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- PLC 连接指示灯（胶囊徽章） -->
                        <Border Style="{StaticResource PillBadge}" Background="#374151" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="PlcConnEllipse" Width="8" Height="8"
                                         Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlcConnText" Text="PLC 未连接" Foreground="#E5E7EB"
                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- SAP/ERP 状态胶囊 -->
                        <Border Style="{StaticResource PillBadge}" Background="#374151" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SapConnEllipse" Width="8" Height="8"
                                         Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SapConnText" Text="SAP 待检测" Foreground="#FCD34D"
                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- 时钟 -->
                        <Border Style="{StaticResource PillBadge}" Background="#111827">
                            <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="16" FontWeight="Bold"
                                       Foreground="#60A5FA" VerticalAlignment="Center" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 工具栏（圆角胶囊按钮 + 语义色） -->
                <Border Background="#111827" Padding="14,10">
                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="🔄 刷新SAP/ERP单据"
                                Style="{StaticResource ButtonInfo}" Click="RefreshOrders_Click"/>
                        <Button Content="📦 手动创建单据"
                                Style="{StaticResource ButtonSuccess}" Click="CreateManualOrder_Click" Margin="8,0,0,0"/>
                        <Border Width="1" Height="20" Background="#374151" VerticalAlignment="Center" Margin="12,0"/>
                        <Button Content="📊 鹤位布局" Background="{StaticResource Primary-500}" Foreground="White"
                                Click="ToggleLayout_Click" Margin="0,0,0,0"/>
                        <Button Content="⚙ 系统设置" Background="{StaticResource Gray-600}" Foreground="White"
                                Click="OpenSettings_Click" Margin="8,0,0,0"/>

                        <!-- 右侧危险操作区（推到最右） -->
                        <Grid Width="1*" MinWidth="10"/>
                        <Button Content="⚠ 全局紧急停止" Style="{StaticResource ButtonDangerStrong}"
                                FontWeight="Bold" Click="GlobalEmergency_Click" Margin="0,0,0,0"/>
                        <Button Content="↻ 全局复位" Style="{StaticResource ButtonInfo}"
                                FontWeight="Bold" Click="GlobalReset_Click" Margin="8,0,0,0"
                                ToolTip="强制复位所有鹤位：清零实时数据/报警/订单引用，恢复空闲状态"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===================== 主内容区 ===================== -->
        <Grid Margin="0,0,0,0" Background="{StaticResource AppBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" MinWidth="400"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：单据管理卡片（Card 容器 + 阴影 + 圆角 12） -->
            <Border Grid.Column="0" Style="{StaticResource CardContainer}" Margin="16,16,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 模块标题 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12" Orientation="Horizontal">
                        <Border Width="4" Height="22" CornerRadius="2" Background="{StaticResource PrimaryGradient}" VerticalAlignment="Center"/>
                        <TextBlock Text="单据管理" FontWeight="Bold" FontSize="15"
                                   Foreground="{StaticResource TextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Tab 切换（胶囊样式） -->
                    <TabControl Grid.Row="0" x:Name="OrderTabs" SelectionChanged="OrderTabs_SelectionChanged"
                                Background="Transparent" BorderThickness="0" TabStripPlacement="Top"
                                Margin="0,36,0,0" Padding="0,0,0,0">
                        <TabItem Header="📋 待下发"   Style="{StaticResource PillTabItem}"/>
                        <TabItem Header="⏳ 进行中"   Style="{StaticResource PillTabItem}"/>
                        <TabItem Header="✅ 已完成"   Style="{StaticResource PillTabItem}"/>
                    </TabControl>

                    <!-- DataGrid 单据列表（Theme 里已经全局样式） -->
                    <DataGrid Grid.Row="1" x:Name="OrdersGrid" AutoGenerateColumns="False"
                              Margin="0,8,0,0"
                              MouseDoubleClick="OrdersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="单据号"   Binding="{Binding OrderNo}"                    Width="140"/>
                            <DataGridTextColumn Header="车牌"     Binding="{Binding VehicleNo}"                  Width="80"/>
                            <DataGridTextColumn Header="产品"     Binding="{Binding ProductName}"                Width="110"/>
                            <DataGridTextColumn Header="计划量"   Binding="{Binding PlannedWeight, StringFormat='{}{0:0}'}" Width="70"/>
                            <DataGridTextColumn Header="鹤位"     Binding="{Binding AssignedCraneId}"             Width="60"/>
                            <!-- 状态列（语义色渲染） -->
                            <DataGridTextColumn Header="状态" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Created">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Dispatched">
                                                <Setter Property="Foreground" Value="{StaticResource Accent-500}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.Binding><Binding Path="Status"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="✉ 下发到鹤位" Click="DispatchOrderMenu_Click" x:Name="DispatchMenu"/>
                                <MenuItem Header="❌ 取消单据" Click="CancelOrderMenu_Click" x:Name="CancelMenu"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 分隔条（隐形 8px 间距 + 可拖拽） -->
            <GridSplitter Grid.Column="1" Width="0" Background="Transparent" ResizeBehavior="PreviousAndCurrent"/>

            <!-- 右侧：鹤位卡片区域（外层 Card + 内层 WrapPanel） -->
            <Border Grid.Column="2" Margin="8,16,16,8" Style="{StaticResource CardContainer}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 模块标题 + 鹤位标签 -->
                    <Grid Grid.Row="0" Margin="16,16,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="4" Height="22" CornerRadius="2" Background="{StaticResource SuccessGradient}" VerticalAlignment="Center"/>
                            <TextBlock Text="鹤位控制" FontWeight="Bold" FontSize="15"
                                       Foreground="{StaticResource TextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <WrapPanel x:Name="CraneHeaderPanel" Grid.Column="1" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 分隔细线 -->
                    <Border Grid.Row="1" Height="1" Background="{StaticResource Gray-100}" Margin="16,12,16,0"/>

                    <!-- 鹤位卡片 WrapPanel（关键：HorizontalScrollBarVisibility=Disabled 才能换行） -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" Margin="4,8,4,8"
                                  ScrollViewer.CanContentScroll="True">
                        <WrapPanel x:Name="CraneWrapPanel" Orientation="Horizontal" Margin="8,8"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== 底部状态栏 ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusBarBackground}" Height="30"
                VerticalAlignment="Bottom" Padding="20,0" Effect="{StaticResource ShadowCardSm}">
            <Grid>
                <TextBlock Text="{Binding StatusBarText}" Foreground="#D1D5DB" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas"/>
                <TextBlock x:Name="StatusRight" HorizontalAlignment="Right" Foreground="#9CA3AF"
                           VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
