<Application x:Class="CraneLoadingSystem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             DispatcherUnhandledException="App_DispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 现代化 UI 主题（所有颜色/圆角/阴影/控件默认样式都在这里） -->
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Application-wide 全局字体：Segoe UI + 微软雅黑回退 -->
            <FontFamily x:Key="GlobalFontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei, PingFang SC</FontFamily>

            <!-- 应用级默认字号（可被局部覆盖） -->
            <sys:Double x:Key="GlobalFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
