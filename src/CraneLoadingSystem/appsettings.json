{
  "AppSettings": {
    "SystemName": "流体装卸鹤位上位机系统",
    "DefaultCraneCount": 4,
    "DataRefreshIntervalMs": 1000,
    "EnableSimulation": true
  },
  "PlcSettings": {
    "Mode": "TCP",
    "IpAddress": "127.0.0.1",
    "Port": 502,
    "SerialPort": "COM1",
    "BaudRate": 9600,
    "TimeoutMs": 3000,
    "Retries": 3,
    "ReconnectIntervalMs": [ 1000, 2000, 4000, 8000 ]
  },
  "SapSettings": {
    "BaseUrl": "http://localhost:8000",
    "ClientId": "CRANE_LOADING",
    "ClientSecret": "",
    "UserName": "sapuser",
    "Password": "",
    "TimeoutSeconds": 30,
    "ODataServicePath": "/sap/opu/odata/sap/Z_CARGO_LOADING_SRV/"
  },
  "ErpSettings": {
    "BaseUrl": "http://localhost:8080/api",
    "ApiKey": "demo-api-key",
    "TimeoutSeconds": 30
  },
  "RfidSettings": {
    "Port": "COM2",
    "BaudRate": 9600,
    "PollingIntervalMs": 500
  },
  "Database": {
    "ConnectionString": "Data Source=crane_loading.db",
    "RetentionDays": 90
  },
  "CranePositions": [
    {
      "Id": "CP001",
      "Name": "1#鹤位",
      "ProductName": "汽油",
      "MaxFlowRate": 300,
      "PlcAddress": 1
    },
    {
      "Id": "CP002",
      "Name": "2#鹤位",
      "ProductName": "柴油",
      "MaxFlowRate": 280,
      "PlcAddress": 2
    },
    {
      "Id": "CP003",
      "Name": "3#鹤位",
      "ProductName": "煤油",
      "MaxFlowRate": 250,
      "PlcAddress": 3
    },
    {
      "Id": "CP004",
      "Name": "4#鹤位",
      "ProductName": "液化气",
      "MaxFlowRate": 200,
      "PlcAddress": 4
    }
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}